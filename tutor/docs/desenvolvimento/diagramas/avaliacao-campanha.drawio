<mxfile host="drawio"><diagram id="avaliacao-campanha" name="Campanha de avaliação"><mxGraphModel dx="900" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Campanha: como uma conversa de teste é produzida e analisada" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="30" as="geometry" /></mxCell><mxCell id="n2" value="Leia da esquerda para a direita, na ordem dos números. Vermelho: instrumento de avaliação; azul: sistema avaliado." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1460" height="24" as="geometry" /></mxCell><mxCell id="n3" value="Preparar" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="230" height="24" as="geometry" /></mxCell><mxCell id="n4" value="Conduzir as conversas" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="270" y="92" width="230" height="24" as="geometry" /></mxCell><mxCell id="n5" value="Registrar" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="770" y="92" width="230" height="24" as="geometry" /></mxCell><mxCell id="n6" value="Analisar" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="1010" y="92" width="230" height="24" as="geometry" /></mxCell><mxCell id="n7" value="Concluir" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="1310" y="92" width="230" height="24" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Entradas&lt;/b&gt;&lt;br&gt;exercícios, perfis P01–P05,&lt;br&gt;modelos e manifesto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="200" height="120" as="geometry" /></mxCell><mxCell id="n9" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="38" y="208" width="22" height="22" as="geometry" /></mxCell><mxCell id="n10" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="18" y="188" width="26" height="26" as="geometry" /></mxCell><mxCell id="n11" value="Para cada episódio: 45 no total, até 5 em paralelo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#FBF4F4;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="460" height="240" as="geometry" /></mxCell><mxCell id="n12" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="258" y="128" width="26" height="26" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;Aluno simulado&lt;/b&gt;&lt;br&gt;fala de acordo com&lt;br&gt;o perfil e a fase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="180" height="120" as="geometry" /></mxCell><mxCell id="n14" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="298" y="208" width="22" height="22" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Tutor sob teste&lt;/b&gt;&lt;br&gt;recebe só a fala,&lt;br&gt;pela rota de pesquisa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="530" y="200" width="180" height="120" as="geometry" /></mxCell><mxCell id="n16" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="538" y="208" width="22" height="22" as="geometry" /></mxCell><mxCell id="n17" value="repete até a sondagem fechar (no máximo 10 turnos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;align=center;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="290" y="335" width="420" height="30" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;Episódios gravados&lt;/b&gt;&lt;br&gt;diálogo, estados,&lt;br&gt;auditoria e custos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="770" y="200" width="200" height="120" as="geometry" /></mxCell><mxCell id="n19" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="77