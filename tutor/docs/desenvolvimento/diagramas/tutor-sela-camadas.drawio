<mxfile host="drawio"><diagram id="sela-camadas" name="Camadas da SELA no tutor"><mxGraphModel dx="900" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Um turno dentro do tutor: os três níveis da SELA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1220" height="30" as="geometry" /></mxCell><mxCell id="n2" value="Leia de cima para baixo, na ordem dos números. Cada faixa é um nível; robô: agente LLM; demais ícones: componentes sem LLM." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1220" height="24" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Fala do estudante&lt;/b&gt;&lt;br&gt;um único campo de texto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="85" width="330" height="60" as="geometry" /></mxCell><mxCell id="n4" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="93" width="22" height="22" as="geometry" /></mxCell><mxCell id="n5" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5A8C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="73" width="26" height="26" as="geometry" /></mxCell><mxCell id="n6" value="No turno seguinte, a nova fala do estudante entra direto no passo 4 (N2); o contrato do passo 3 continua valendo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="820" height="40" as="geometry" /></mxCell><mxCell id="n7" value="Nível 0 · adaptador de domínio (só na primeira fala de cada sondagem)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="1200" height="170" as="geometry" /></mxCell><mxCell id="n8" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="38" y="178" width="22" height="22" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;N0-A · portão curricular&lt;/b&gt;&lt;br&gt;a fala é de Programação I?&lt;br&gt;se não for, o tutor responde com a&lt;br&gt;mensagem padrão, sem pergunta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="330" height="110" as="geometry" /></mxCell><mxCell id="n10" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="218" width="22" height="22" as="geometry" /></mxCell><mxCell id="n11" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="198" width="26" height="26" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;N0-B · diagnóstico&lt;/b&gt;&lt;br&gt;lacuna, evidência citada da fala,&lt;br&gt;critério e 1 a 3 requisitos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="380" height="110" as="geometry" /></mxCell><mxCell id="n13" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="428" y="218" width="22" height="22" as="geometry" /></mxCell><mxCell id="n14" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="408" y="198" width="26" height="26" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Contrato N0 imutável&lt;/b&gt;&lt;br&gt;lido pelos níveis 2 e 1;&lt;br&gt;nenhum deles o redefine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#FFF2CC;strokeColor=#D6B656;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="210" width="370" height="110" as="geometry" /></mxCell><mxCell id="n16" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="848" y="218" width="22" height="22" as="geometry" /></mxCell><mxCell id="n17" value="Nível 2 · estado e planejamento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="1200" height="170" as="geometry" /></mxCell><mxCell id="n18" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="38" y="388" width="22" height="22" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;N2 · avalia e planeja&lt;/b&gt;&lt;br&gt;avalia cada requisito com citações da fala;&lt;br&gt;plano abstrato para o N1 (não redige a pergunta)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="520" height="110" as="geometry" /></mxCell><mxCell id="n20" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="428" width="22" height="22" as="geometry" /></mxCell><mxCell id="n21" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2F855A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="408" width="26" height="26" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b&gt;Guarda de resolução&lt;/b&gt;&lt;br&gt;confere as citações;&lt;br&gt;pode vetar a resolução" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="290" height="110" as="geometry" /></mxCell><mxCell id="n23" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="608" y="428" width="22" height="22" as="geometry" /></mxCell><mxCell id="n24" value="&lt;b&gt;Estado e modo&lt;/b&gt;&lt;br&gt;sondagem (até 10 turnos),&lt;br&gt;resolvida ou encerrada no limite" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="420" width="290" height="110" as="geometry" /></mxCell><mxCell id="n25" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="928" y="428" width="22" height="22" as="geometry" /></mxCell><mxCell id="n26" value="Nível 1 · pergunta e publicação" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="1200" height="170" as="geometry" /></mxCell><mxCell id="n27" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="38" y="598" width="22" height="22" as="geometry" /></mxCell><mxCell id="n28" value="&lt;b&gt;N1-G · gera&lt;/b&gt;&lt;br&gt;uma pergunta candidata&lt;br&gt;e o nível de exposição" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="630" width="300" height="110" as="geometry" /></mxCell><mxCell id="n29" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="638" width="22" height="22" as="geometry" /></mxCell><mxCell id="n30" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5A8C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="618" width="26" height="26" as="geometry" /></mxCell><mxCell id="n31" value="&lt;b&gt;N1-V · valida&lt;/b&gt;&lt;br&gt;critérios 1.1 a 1.4;&lt;br&gt;aprova ou reprova, sem reescrever" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="340" height="110" as="geometry" /></mxCell><mxCell id="n32" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="388" y="638" width="22" height="22" as="geometry" /></mxCell><mxCell id="n33" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5A8C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="368" y="618" width="26" height="26" as="geometry" /></mxCell><mxCell id="n34" value="&lt;b&gt;Barreira de publicação&lt;/b&gt;&lt;br&gt;sem LLM: confere o nível de exposição&lt;br&gt;e a forma do texto (uma pergunta curta, sem código)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="750" y="630" width="460" height="110" as="geometry" /></mxCell><mxCell id="n35" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="758" y="638" width="22" height="22" as="geometry" /></mxCell><mxCell id="n36" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5A8C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="738" y="618" width="26" height="26" as="geometry" /></mxCell><mxCell id="n37" value="&lt;b&gt;Se não aprovada&lt;/b&gt;&lt;br&gt;N1-G gera de novo (1 vez); esgotado, vai a mensagem segura do modo;&lt;br&gt;veto de resolução ou mensagem segura recusada interrompem o turno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#FFF7E6;strokeColor=#D6B656;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="830" width="670" height="80" as="geometry" /></mxCell><mxCell id="n38" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="838" width="22" height="22" as="geometry" /></mxCell><mxCell id="n39" value="&lt;b&gt;Publicada ao estudante&lt;/b&gt;&lt;br&gt;texto idêntico à candidata aprovada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#D5E8D4;strokeColor=#82B366;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="750" y="830" width="460" height="80" as="geometry" /></mxCell><mxCell id="n40" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjM0E1QThDIiBzdHJva2Utd2lkdGg9IjEuOCIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNNCA1aDE2djExSDlsLTUgNHoiLz48cGF0aCBkPSJNOCA5LjVoOE04IDEyLjVoNSIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="758" y="838" width="22" height="22" as="geometry" /></mxCell><mxCell id="n41" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5A8C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="738" y="818" width="26" height="26" as="geometry" /></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="360" /><mxPoint x="310" y="360" /></Array></mxGeometry></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="570" /><mxPoint x="200" y="570" /></Array></mxGeometry></mxCell><mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="n28" target="n31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="n31" target="n34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#777777;fontColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.746;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#777777;fontColor=#555555;exitX=0.109;exitY=1;exitDx=0;exitDy=0;entryX=0.91;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="795" /><mxPoint x="660" y="795" /></Array></mxGeometry></mxCell><mxCell id="n54" value="Escala de exposição: 1 conceito · 2 dica · 3 pseudocódigo · 4 trecho parcial · 5 solução completa. Na sondagem, até 3; no limite, até 4; com a lacuna resolvida, até 5. O orquestrador encadeia os passos e não é um nível." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="1200" height="60" as="geometry" /></mxCell><mxCell id="n53_lbl" value="bloqueada" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="672" y="773" width="70" height="18" as="geometry" /></mxCell><mxCell id="n52_lbl" value="reprovada" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="558" y="776" width="70" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>