<mxfile host="drawio"><diagram id="visao-geral" name="Visão geral do sistema"><mxGraphModel dx="900" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Visão geral: quem usa, o que é o sistema avaliado e o que fica fora dele" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1360" height="30" as="geometry" /></mxCell><mxCell id="n2" value="Três faixas de cima para baixo: pessoas, sistemas e modelos. Azul: sistema avaliado; vermelho: instrumento de avaliação, fora dele. Só o servidor do tutor e o PostgreSQL rodam no Docker Compose." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1360" height="24" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Aluno&lt;/b&gt;&lt;br&gt;conversa pelo navegador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="240" height="64" as="geometry" /></mxCell><mxCell id="n4" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="68" y="98" width="22" height="22" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;usuários e experimentos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="240" height="64" as="geometr