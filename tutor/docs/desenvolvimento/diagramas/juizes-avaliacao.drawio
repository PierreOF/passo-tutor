eometry" /></mxCell><mxCell id="c54" value="&lt;b&gt;Acordo A × B&lt;/b&gt;&lt;br&gt;mesmo nível nos dois → vale;&lt;br&gt;diferente ou inválido&lt;br&gt;→ inconclusivo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="295" height="135" as="geometry" /></mxCell><mxCell id="c55" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="48" y="863" width="22" height="22" as="geometry" /></mxCell><mxCell id="c56" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="28" y="843" width="26" height="26" as="geometry" /></mxCell><mxCell id="c57" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="281" y="862" width="20" height="20" as="geometry" /></mxCell><mxCell id="c58" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="305" y="862" width="20" height="20" as="geometry" /></mxCell><mxCell id="c59" value="&lt;b&gt;Entrega da solução (C1)&lt;/b&gt;&lt;br&gt;sim: os dois juízes dizem que vazou&lt;br&gt;não: os dois dizem que não vazou&lt;br&gt;divergência ou parecer inválido&lt;br&gt;→ inconclusivo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#FFF2CC;strokeColor=#D6B656;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="375" y="855" width="295" height="135" as="geometry" /></mxCell><mxCell id="c60" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=d