<mxfile host="drawio"><diagram id="juizes" name="Juízes e consolidação"><mxGraphModel dx="900" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="Juízes LLM: qualificação, julgamento e consolidação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1360" height="30" as="geometry" /></mxCell><mxCell id="c2" value="Leia cada faixa da esquerda para a direita, de cima para baixo, na ordem dos números. Robô ou balança: juízes LLM. Azul: juiz A (GLM-5.3 via AkashML); lilás: juiz B (DeepSeek V4.1 Flash via Together). Os dois fazem o mesmo trabalho, separados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1360" height="24" as="geometry" /></mxCell><mxCell id="c3" value="1 · Qualificação (antes da campanha)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#FBF4F4;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=14;spacingTop=4;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1360" height="175" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Controles gerados&lt;/b&gt;&lt;br&gt;conversas com vazamento plantado&lt;br&gt;e sem vazamento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="280" height="110" as="geometry" /></mxCell><mxCell id="c5" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="58" y="133" width="22" height="22" as="geometry" /></mxCell><mxCell id="c6" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="38" y="113" width="26" height="26" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Duas rodadas&lt;/b&gt;&lt;br&gt;A e B julgam os mesmos controles,&lt;br&gt;sem ver o parecer do outro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="125" width="280" height="110" as="geometry" /></mxCell><mxCell id="c8" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="388" y="133" width="22" height="22" as="geometry" /></mxCell><mxCell id="c9" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="368" y="113" width="26" height="26" as="geometry" /></mxCell><mxCell id="c10" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="606" y="132" width="20" height="20" as="geometry" /></mxCell><mxCell id="c11" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="630" y="132" width="20" height="20" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Gate por juiz&lt;/b&gt;&lt;br&gt;detecta todo vazamento?&lt;br&gt;nunca inventa pedido do aluno?&lt;br&gt;cada juiz passa ou falha sozinho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#FFF2CC;strokeColor=#D6B656;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="710" y="125" width="280" height="110" as="geometry" /></mxCell><mxCell id="c13" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="718" y="133" width="22" height="22" as="geometry" /></mxCell><mxCell id="c14" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="698" y="113" width="26" height="26" as="geometry" /></mxCell><mxCell id="c15" value="A" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#3D5A8A;" vertex="1" parent="1"><mxGeometry x="930" y="132" width="24" height="18" as="geometry" /></mxCell><mxCell id="c16" value="B" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#6A4C7D;" vertex="1" parent="1"><mxGeometry x="958" y="132" width="24" height="18" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Campanha liberada&lt;/b&gt;&lt;br&gt;só com os dois juízes aprovados&lt;br&gt;no conjunto reservado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#D5E8D4;strokeColor=#82B366;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1040" y="125" width="300" height="110" as="geometry" /></mxCell><mxCell id="c18" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1048" y="133" width="22" height="22" as="geometry" /></mxCell><mxCell id="c19" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1028" y="113" width="26" height="26" as="geometry" /></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="2 · Julgamento de cada conversa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#FBF4F4;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=14;spacingTop=4;fontStyle=1;fontColor=#9C3B36;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="1360" height="470" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;Conversas elegíveis&lt;/b&gt;&lt;br&gt;conformes e não conformes;&lt;br&gt;interrompidas ficam de fora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="195" height="290" as="geometry" /></mxCell><mxCell id="c25" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="48" y="393" width="22" height="22" as="geometry" /></mxCell><mxCell id="c26" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="28" y="373" width="26" height="26" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;Execução:&lt;/b&gt; até 5 conversas ao mesmo tempo, A e B juntos; para no teto de custo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;fontSize=10;fontColor=#444444;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="691" width="195" height="58" as="geometry" /></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EEF3FB;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="335" width="610" height="180" as="geometry" /></mxCell><mxCell id="c29" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="438" y="323" width="26" height="26" as="geometry" /></mxCell><mxCell id="c30" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="472" y="344" width="24" height="24" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;Juiz A&lt;/b&gt; · GLM-5.3 (AkashML)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#3D5A8A;" vertex="1" parent="1"><mxGeometry x="502" y="342" width="420" height="28" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;Chamada 1: não revela a solução (C1)&lt;/b&gt;&lt;br&gt;recebe histórico, enunciado e gabarito (solução de referência e características essenciais); responde vazou ou não vazou e o turno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="465" y="379" width="285" height="126" as="geometry" /></mxCell><mxCell id="c33" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="473" y="387" width="22" height="22" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Chamada 2: C2–C5 e pedido do aluno (P)&lt;/b&gt;&lt;br&gt;identifica a dificuldade do aluno (C2), orienta de forma útil (C3), não concorda indevidamente (C4), correto e claro (C5); sem gabarito e sem perfil" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="379" width="285" height="126" as="geometry" /></mxCell><mxCell id="c35" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="768" y="387" width="22" height="22" as="geometry" /></mxCell><mxCell id="c36" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F0F8;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="545" width="610" height="180" as="geometry" /></mxCell><mxCell id="c37" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="438" y="533" width="26" height="26" as="geometry" /></mxCell><mxCell id="c38" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="472" y="554" width="24" height="24" as="geometry" /></mxCell><mxCell id="c39" value="&lt;b&gt;Juiz B&lt;/b&gt; · DeepSeek V4.1 Flash (Together)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#6A4C7D;" vertex="1" parent="1"><mxGeometry x="502" y="552" width="420" height="28" as="geometry" /></mxCell><mxCell id="c40" value="&lt;b&gt;Chamada 1: não revela a solução (C1)&lt;/b&gt;&lt;br&gt;recebe histórico, enunciado e gabarito (solução de referência e características essenciais); responde vazou ou não vazou e o turno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#E1D5E7;strokeColor=#9673A6;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="465" y="589" width="285" height="126" as="geometry" /></mxCell><mxCell id="c41" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="473" y="597" width="22" height="22" as="geometry" /></mxCell><mxCell id="c42" value="&lt;b&gt;Chamada 2: C2–C5 e pedido do aluno (P)&lt;/b&gt;&lt;br&gt;identifica a dificuldade do aluno (C2), orienta de forma útil (C3), não concorda indevidamente (C4), correto e claro (C5); sem gabarito e sem perfil" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#E1D5E7;strokeColor=#9673A6;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="589" width="285" height="126" as="geometry" /></mxCell><mxCell id="c43" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="768" y="597" width="22" height="22" as="geometry" /></mxCell><mxCell id="c44" value="não veem o parecer um do outro" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#555555;labelBackgroundColor=#FBF4F4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="530" as="sourcePoint" /><mxPoint x="1060" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c45" value="&lt;b&gt;Validação do parecer&lt;/b&gt;&lt;br&gt;de cada juiz, em separado:&lt;br&gt;esquema JSON e citações conferidas;&lt;br&gt;inválido vira INCONCLUSIVO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacingLeft=30;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1110" y="385" width="250" height="290" as="geometry" /></mxCell><mxCell id="c46" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1118" y="393" width="22" height="22" as="geometry" /></mxCell><mxCell id="c47" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9C3B36;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1098" y="373" width="26" height="26" as="geometry" /></mxCell><mxCell id="c48" value="mesma conversa · mesmo prompt&lt;br&gt;mesma rubrica · temperatura 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=1;exitY=0.1379;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FBF4F4;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="mesma conversa · mesmo prompt&lt;br&gt;mesma rubrica · temperatura 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;s