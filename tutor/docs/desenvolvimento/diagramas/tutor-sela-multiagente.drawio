<mxfile host="drawio"><diagram id="sela-multiagente" name="SELA como sistema multiagente"><mxGraphModel dx="900" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="SELA no tutor: cinco agentes LLM em três níveis, coordenados por um orquestrador que não é um nível" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Provedor de modelos (OpenRouter)&lt;/b&gt;&lt;br&gt;um modelo para os cinco agentes (Qwen3.8 Max)&lt;br&gt;cada agente tem prompt e esquema JSON próprios" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="360" height="110" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Orquestrador (MultiAgentTutor)&lt;/b&gt;&lt;br&gt;chama os agentes na ordem e passa os dados estruturados entre eles&lt;br&gt;não diagnostica, não planeja, não redige e não é um nível" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="580" height="110" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Aluno&lt;/b&gt;&lt;br&gt;envia uma fala por turno, pelo chat&lt;br&gt;recebe o texto publicado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="60" width="360" height="110" as="geometry" /></mxCell><mxCell id="n5" value="" style="rounded=0;fillColor=#4A5568;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="82" y="222" width="1170" height="6" as="geometry" /></mxCell><mxCell id="n6" value="chamadas na ordem 1 → 5, cada uma com entradas e saída em JSON" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="196" width="600" height="22" as="geometry" /></mxCell><mxCell id="n7" value="Nível 0 · adaptador de domínio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="560" height="330" as="geometry" /></mxCell><mxCell id="n8" value="Nível 2 · estado e plano" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="255" width="290" height="330" as="geometry" /></mxCell><mxCell id="n9" value="Nível 1 · pergunta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fillColor=#F7FAFF;strokeColor=#6C8EBF;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontStyle=1;fontColor=#3A5A8C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="255" width="560" height="330" as="geometry" /></mxCell><mxCell id="n10" value="&lt;div style=&quot;margin-left:30px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;1 · N0-A · portão curricular&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;primeira fala da sondagem&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Recebe&lt;/b&gt;&lt;br&gt;fala do aluno; escopo de Programação I (PPC)&lt;br&gt;&lt;br&gt;&lt;b&gt;Produz&lt;/b&gt;&lt;br&gt;admissível ou não, assunto, conceitos admitidos e temas proibidos&lt;br&gt;&lt;br&gt;&lt;b&gt;Não pode&lt;/b&gt;&lt;br&gt;diagnosticar a lacuna nem perguntar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="290" width="250" height="230" as="geometry" /></mxCell><mxCell id="n11" value="&lt;div style=&quot;margin-left:30px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;2 · N0-B · diagnóstico&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;logo depois do N0-A, na mesma fala&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Recebe&lt;/b&gt;&lt;br&gt;fala; escopo do N0-A; tipos de lacuna de CS1&lt;br&gt;&lt;br&gt;&lt;b&gt;Produz&lt;/b&gt;&lt;br&gt;contrato N0: afirmação com citação literal, tipo e explicação da lacuna, critério e 1 a 3 requisitos&lt;br&gt;&lt;br&gt;&lt;b&gt;Não pode&lt;/b&gt;&lt;br&gt;perguntar nem mudar o contrato depois" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="250" height="230" as="geometry" /></mxCell><mxCell id="n12" value="&lt;div style=&quot;margin-left:30px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;3 · N2 · avaliador-planejador&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;em todo turno&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Recebe&lt;/b&gt;&lt;br&gt;fala atual, contrato, estado, histórico e turnos de evidência&lt;br&gt;&lt;br&gt;&lt;b&gt;Produz&lt;/b&gt;&lt;br&gt;avaliação de cada requisito com citação, estado atualizado, plano abstrato e se a lacuna foi resolvida&lt;br&gt;&lt;br&gt;&lt;b&gt;Não pode&lt;/b&gt;&lt;br&gt;redigir ou publicar a pergunta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="290" width="250" height="230" as="geometry" /></mxCell><mxCell id="n13" value="&lt;div style=&quot;margin-left:30px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;4 · N1-G · gerador&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;em todo turno&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Recebe&lt;/b&gt;&lt;br&gt;contrato, plano, estado, escopo, formas de evidência e pergunta anterior&lt;br&gt;&lt;br&gt;&lt;b&gt;Produz&lt;/b&gt;&lt;br&gt;candidata (uma pergunta na sondagem), nível de exposição e função socrática&lt;br&gt;&lt;br&gt;&lt;b&gt;Não pode&lt;/b&gt;&lt;br&gt;publicar nem alterar o contrato" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="250" height="230" as="geometry" /></mxCell><mxCell id="n14" value="&lt;div style=&quot;margin-left:30px&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;5 · N1-V · validador&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;a cada candidata&lt;/i&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Recebe&lt;/b&gt;&lt;br&gt;candidata, contrato, plano, estado e evidência de resolução&lt;br&gt;&lt;br&gt;&lt;b&gt;Produz&lt;/b&gt;&lt;br&gt;aprova ou reprova, critérios 1.1 a 1.4, categoria socrática e nível; reprovada, o N1-G gera de novo (1 vez)&lt;br&gt;&lt;br&gt;&lt;b&gt;Não pode&lt;/b&gt;&lt;br&gt;reescrever a candidata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="290" width="250" height="230" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;Guardas determinísticas (sem LLM)&lt;/b&gt;&lt;br&gt;conferem toda saída de agente: esquema JSON, citação literal da fala, coerência dos requisitos e da resolução&lt;br&gt;uma correção por regra violada; outra recusa interrompe o turno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="45" y="620" width="1145" height="75" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;Barreira de publicação&lt;/b&gt;&lt;br&gt;nível e forma do texto;&lt;br&gt;aprovada, publica" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1215" y="620" width="250" height="75" as="geometry" /></mxCell><mxCell id="n17" value="Estado da sessão: a memória compartilhada, lida e gravada pelo orquestrador a cada turno (os agentes não se falam diretamente)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#F5F5F5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1460" height="150" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;Contrato N0 imutável&lt;/b&gt;&lt;br&gt;escrito uma vez pelo N0-B;&lt;br&gt;lido por N2, N1-G e N1-V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="340" height="90" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;Estado e modo&lt;/b&gt;&lt;br&gt;requisitos, compreensão e teto de exposição;&lt;br&gt;modo e contador decididos por regra fixa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="770" width="340" height="90" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b&gt;Histórico público&lt;/b&gt;&lt;br&gt;falas do aluno e perguntas publicadas;&lt;br&gt;base das citações literais" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="770" y="770" width="340" height="90" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b&gt;Auditoria&lt;/b&gt;&lt;br&gt;eventos, hashes e custos de cada chamada;&lt;br&gt;fora do alcance dos agentes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="770" width="340" height="90" as="geometry" /></mxCell><mxCell id="n22" value="Invariantes: N0 vem antes de N1 · N1 não redefine o contrato · N2 não redige a pergunta · N1-G não publica sem a aprovação do N1-V e da barreira · o orquestrador coordena sem absorver a responsabilidade de um nível." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="892" width="1460" height="40" as="geometry" /></mxCell><mxCell id="n23" value="Robô: agente LLM. Os demais ícones são componentes determinísticos ou dados. Cores: amarelo-escuro Nível 0, verde Nível 2, azul Nível 1, cinza sem LLM." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#444444;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="932" width="1460" height="30" as="geometry" /></mxCell><mxCell id="n24" value="fala" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n25" value="uma chamada por agente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n27" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n28" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.235;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n29" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n30" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.765;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n31" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.109;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.349;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0