# Integracao OpenRouter. Nao versionar o arquivo .env real.
TUTOR_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
TUTOR_LLM_MODEL=qwen/qwen3.8-2.4t-a95b
TUTOR_LLM_BASE_URL=https://openrouter.ai/api/v1
TUTOR_LLM_SITE_URL=http://localhost:5173
TUTOR_LLM_APP_TITLE=TCC Tutor Socratico Multiagente
TUTOR_LLM_TEMPERATURE=0.0
TUTOR_LLM_MAX_TOKENS=6000
TUTOR_LLM_TIMEOUT_SECONDS=150
TUTOR_LLM_MAX_RETRIES=2
TUTOR_LLM_MAX_REWRITES=1
TUTOR_LLM_ZDR=true
TUTOR_LLM_DATA_COLLECTION=deny
# Rota do tutor no OpenRouter: mesmo valor de tutor.provider_slug em avaliacao/modelos.v1.json (tutor na SiliconFlow, ADR 0016; aluno e juizes na Together).
TUTOR_LLM_PROVIDER_SLUG=siliconflow
TUTOR_LLM_ALLOW_PROVIDER_FALLBACKS=false
# Esforco de raciocinio (reasoning.effort): minimal, low, medium ou high; vazio = nao enviar. Mesmo valor de tutor.reasoning_effort.
TUTOR_LLM_REASONING_EFFORT=low
# Token local para evidencias restritas da campanha; use valor aleatorio forte no .env real.
TUTOR_RESEARCH_TOKEN=
# O Compose cria os bancos passo e passo_test. Troque a senha no .env local.
POSTGRES_USER=passo
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://passo:change-me-locally@127.0.0.1:55432/passo
TEST_DATABASE_URL=postgresql://passo:change-me-locally@127.0.0.1:55432/passo_test
APP_ENV=development
SESSION_COOKIE_SECURE=false
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8000
